# Auth0 Configuration
# Get these values from your Auth0 dashboard
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.watch2play.local
AUTH0_ALGORITHMS=RS256

# Auth0 Management API (for admin features like user impersonation)
# Create a Machine-to-Machine application in Auth0 and authorize it for the Management API
# Grant permissions: read:users, read:roles, update:users_app_metadata
AUTH0_MGMT_DOMAIN=YOUR_TENANT.us.auth0.com  # Required if using custom domain - use your tenant domain, not custom domain
AUTH0_MGMT_CLIENT_ID=<machine-to-machine-client-id>
AUTH0_MGMT_CLIENT_SECRET=<machine-to-machine-client-secret>

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Stripe Configuration
# Get these values from your Stripe dashboard (use test keys for development)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Create a product with multiple prices in Stripe dashboard for each RAM tier
STRIPE_PRICE_ID_2GB=price_xxxxx
STRIPE_PRICE_ID_4GB=price_xxxxx
STRIPE_PRICE_ID_6GB=price_xxxxx
STRIPE_PRICE_ID_8GB=price_xxxxx
STRIPE_SUCCESS_URL=https://minecrafthosting.gg?payment=success
STRIPE_CANCEL_URL=https://minecrafthosting.gg?payment=canceled
