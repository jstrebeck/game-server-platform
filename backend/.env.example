# Auth0 Configuration
# Get these values from your Auth0 dashboard
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.watch2play.local
AUTH0_ALGORITHMS=RS256

# Auth0 Management API (for admin features like user impersonation)
# Create a Machine-to-Machine application in Auth0 and authorize it for the Management API
# Grant permissions: read:users, read:roles
AUTH0_MGMT_CLIENT_ID=<machine-to-machine-client-id>
AUTH0_MGMT_CLIENT_SECRET=<machine-to-machine-client-secret>

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
